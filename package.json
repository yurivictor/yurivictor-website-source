{
  "name": "yurivictor.github.io",
  "version": "1.0.0",
  "description": "My personal homepage",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel watch serve",
    "serve": "vite",
    "watch:scss": "sass --watch src/scss:src/css",
    "watch": "npm-run-all --parallel watch:*",
    "build:scss": "sass src/scss:src/css",
    "build:autoprefixer": "postcss src/css/*.css --use autoprefixer -d src/css",
    "build:css-lint": "postcss src/css/*.css --use cssnano -d dist/css",
    "build:css-minify": "css-minify -d dist/css",
    "build:js": "vite build",
    "build:copy-assets": "cp src/assets/*.woff src/assets/*.woff2 dist/assets/",
    "build:copy-html": "cp src/index.html dist/",
    "build": "npm-run-all build:scss build:autoprefixer build:css-lint build:css-minify build:js build:copy-assets build:copy-html"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "css-minify": "^2.0.1",
    "cssnano": "^7.0.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.41",
    "postcss-cli": "^11.0.0",
    "sass": "^1.77.8",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "meshline": "^3.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  }
}
